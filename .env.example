# Base de datos (servicio Docker: postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_ticket
POSTGRES_PORT=5432

# URL para el host (NestJS en local). Dentro de Docker sera postgresql://...@postgres:5432/ai_ticket
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_ticket

# Groq (API compatible con OpenAI).
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b

# Backend
PORT=3001

# Frontend (navegador). En Docker se hornea en el build.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Solo el contenedor de Next: fetch de Server Components hacia Nest.
# Compose lo inyecta como http://backend:3001. No hace falta en local.
# API_URL=http://backend:3001
