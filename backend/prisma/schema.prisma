// Esquema de la base operativa. La URL vive en prisma.config.ts (Prisma 7).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ClassificationStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id          String   @id @default(uuid())
  fullName    String
  dateOfBirth DateTime @db.Date
  role        String
  profession  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tickets     Ticket[]
}

// Catalogo fijo. Sin CRUD en esta prueba (deuda tecnica).
model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String
  active      Boolean  @default(true)
  tickets     Ticket[]
}

// Catalogo fijo. Sin CRUD en esta prueba (deuda tecnica).
model Priority {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String
  active      Boolean  @default(true)
  tickets     Ticket[]
}

model Ticket {
  id                   String               @id @default(uuid())
  customerName         String
  title                String
  description          String
  attachmentUrl        String?
  categoryId           Int
  category             Category             @relation(fields: [categoryId], references: [id])
  priorityId           Int
  priority             Priority             @relation(fields: [priorityId], references: [id])
  summary              String?
  status               Status               @default(OPEN)
  ownerId              String?
  owner                User?                @relation(fields: [ownerId], references: [id])
  classificationStatus ClassificationStatus @default(PENDING)
  classificationError  String?
  comments             Comment[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model Comment {
  id          String   @id @default(uuid())
  content     String
  authorName  String   @default("Unknown operator")
  authorRole  String   @default("Head of Operations")
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
